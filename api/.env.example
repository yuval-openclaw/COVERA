NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://localhost:5432/covera

# local = encrypted files on disk (dev only). s3 = production object storage.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Gemini does both generation and embeddings, so this is the only AI key.
# Prefixed to avoid colliding with a GEMINI_API_KEY already in your shell,
# which Node's --env-file will not override. Use a key from a project with
# billing enabled: on the Gemini API's unpaid tier, Google may use submitted
# content to improve its products, which would break Clausa's promise that
# documents are never used for training.
COVERA_GEMINI_API_KEY=
# Optional overrides; model names change faster than code.
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_FAST_MODEL=gemini-2.5-flash

# 32-byte hex key for AES-256-GCM envelope encryption of documents at rest.
# Generate with: openssl rand -hex 32
DOCUMENT_ENCRYPTION_KEY=

# Google sign-in: the iOS OAuth client ID from Google Cloud Console
# (…apps.googleusercontent.com). Leave empty to offer email sign-in only.
GOOGLE_IOS_CLIENT_ID=
