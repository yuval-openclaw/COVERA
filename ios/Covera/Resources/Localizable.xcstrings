    "Part of the evidence was read from a scanned page by transcribing it. Confirm anything decisive against the paper document.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُرئ جزء من الأدلة من صفحة ممسوحة ضوئيًا. يُرجى تأكيد أي معلومة حاسمة بمقارنتها بالمستند الورقي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil der Informationen wurde von einer gescannten Seite transkribiert. Bitte gleichen Sie entscheidende Angaben mit dem Papierdokument ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de la evidencia se leyó de una página escaneada transcribiéndola. Confirme cualquier cosa decisiva con el documento en papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie des preuves a été lue à partir d'une page numérisée par transcription. Confirmez tout élément décisif par rapport au document papier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהראיות נקראו מעמוד סרוק. אמת נתונים מכריעים מול מסמך המקור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबूत का कुछ हिस्सा स्कैन किए गए पृष्ठ से पढ़ा गया था। निर्णायक जानकारी की कागज़ी दस्तावेज़ से पुष्टि करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証拠の一部はスキャンページから転記されました。決定的な情報は紙の書類と照合して確認してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte da prova foi lida de uma página digitalizada por transcrição. Confirme qualquer informação decisiva com o documento em papel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนหนึ่งของหลักฐานถูกอ่านจากหน้าเอกสารที่สแกนโดยการถอดความ โปรดยืนยันข้อมูลที่สำคัญกับเอกสารต้นฉบับ"
          }
        }
      }
    },
