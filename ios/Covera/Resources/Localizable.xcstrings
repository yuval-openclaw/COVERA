        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى Covera. يرجى التحقق من اتصالك والمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera konnte nicht erreicht werden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con Covera. Compruebe su conexión e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Covera. Vérifiez votre connexion et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להגיע ל-Covera. בדוק את החיבור שלך ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera तक नहीं पहुँचा जा सका। अपना कनेक्शन जाँचें और फिर से प्रयास करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contactar a Covera. Verifique a sua ligação e tente novamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถติดต่อ Covera ได้ โปรดตรวจสอบการเชื่อมต่อของคุณแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Covera": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera"
          }
        }
      }
    },
    "Covera already had this document, so nothing was duplicated.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان Covera يمتلك هذا المستند بالفعل، لذلك لم يتم تكرار أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera hatte dieses Dokument bereits, es wurde nichts dupliziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ya tenía este documento, por lo que no se duplicó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera possédait déjà ce document, donc rien n'a été dupliqué."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-Covera כבר היה מסמך זה, כך ששום דבר לא שוכפל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera के पास यह दस्तावेज़ पहले से था, इसलिए कुछ भी डुप्लिकेट नहीं हुआ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraはこの文書をすでに持っていたため、重複はありませんでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Covera já tinha este documento, por isso nada foi duplicado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera มีเอกสารนี้อยู่แล้ว จึงไม่มีการทำซ้ำ"
          }
        }
      }
    },
    "Covera cannot approve or deny anything. Your insurer decides what is covered. Where the wording is ambiguous, you see both readings rather than a guess.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ Covera الموافقة على أي شيء أو رفضه. يقرر مؤمنك ما هو مشمول. عندما تكون الصياغة غامضة، سترى كلا التفسيرين بدلاً من التخمين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera kann nichts genehmigen oder ablehnen. Ihr Versicherer entscheidet, was abgedeckt ist. Bei mehrdeutigen Formulierungen sehen Sie beide Interpretationen anstelle einer Vermutung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera no puede aprobar ni denegar nada. Su aseguradora decide qué está cubierto. Cuando la redacción es ambigua, verá ambas interpretaciones en lugar de una suposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ne peut rien approuver ni refuser. Votre assureur décide de ce qui est couvert. Lorsque le libellé est ambigu, vous voyez les deux interprétations plutôt qu'une supposition."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera אינה יכולה לאשר או לדחות דבר. המבטח שלך מחליט מה מכוסה. כאשר הניסוח מעורפל, תראה את שתי הפרשנויות במקום ניחוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera कुछ भी स्वीकृत या अस्वीकृत नहीं कर सकता। आपका बीमाकर्ता तय करता है कि क्या कवर किया गया है। जहाँ शब्दावली अस्पष्ट है, वहाँ आपको अनुमान के बजाय दोनों व्याख्याएँ दिखेंगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraは何も承認または拒否できません。何が補償されるかは保険会社が決定します。文言が曖昧な場合は、推測ではなく両方の解釈が表示されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Covera não pode aprovar nem negar nada. A sua seguradora decide o que está coberto. Onde a redação é ambígua, verá ambas as interpretações em vez de um palpite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ไม่สามารถอนุมัติหรือปฏิเสธสิ่งใดได้ ผู้ให้บริการประกันของคุณเป็นผู้ตัดสินใจว่าจะครอบคลุมอะไร ในกรณีที่ถ้อยคำกำกวม คุณจะเห็นทั้งสองความหมายแทนที่จะเป็นการคาดเดา"
          }
        }
      }
    },
    "Covera could not complete that request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Covera من إكمال هذا الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera konnte diese Anfrage nicht abschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera no pudo completar esa solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera n'a pas pu satisfaire cette demande."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera לא הצליחה להשלים את הבקשה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera वह अनुरोध पूरा नहीं कर सका।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraはそのリクエストを完了できませんでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Covera não pôde concluir esse pedido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ไม่สามารถดำเนินการตามคำขอนั้นได้"
          }
        }
      }
    },
    "Covera does not choose between these. Your insurer decides which applies.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يختار Covera بين هذه الخيارات. يقرر مؤمنك أيها ينطبق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera trifft hier keine Auswahl. Ihr Versicherer entscheidet, welche zutrifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera no elige entre estas opciones. Su aseguradora decide cuál se aplica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ne choisit pas entre ces options. Votre assureur décide de ce qui s'applique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera אינה בוחרת בין אלה. המבטח שלך מחליט איזה מהם חל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera इनमें से नहीं चुनता। आपका बीमाकर्ता तय करता है कि कौन सा लागू होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraはこれらの中から選択しません。どちらが適用されるかは保険会社が決定します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Covera não escolhe entre estes. A sua seguradora decide qual se aplica."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ไม่ได้เลือกสิ่งเหล่านี้ ผู้ให้บริการประกันของคุณเป็นผู้ตัดสินใจว่าจะใช้สิ่งใด"
          }
        }
      }
    },
    "Covera drafted these but could not trace them to your documents, so it will not show them. Ask your insurer instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صاغ Covera هذه، لكنه لم يتمكن من ربطها بمستنداتك، لذلك لن يعرضها. اسأل مؤمنك بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera hat diese entworfen, konnte sie aber nicht Ihren Dokumenten zuordnen, daher werden sie nicht angezeigt. Fragen Sie stattdessen Ihren Versicherer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera redactó esto pero no pudo vincularlo a sus documentos, por lo que no lo mostrará. Pregunte a su aseguradora en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera a rédigé ces éléments mais n'a pas pu les relier à vos documents, ils ne seront donc pas affichés. Demandez plutôt à votre assureur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ניסחה את אלה אך לא הצליחה לאתר אותם במסמכים שלך, ולכן לא תציג אותם. שאל את המבטח שלך במקום זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ने इन्हें तैयार किया था लेकिन इन्हें आपके दस्तावेज़ों से नहीं जोड़ सका, इसलिए यह इन्हें नहीं दिखाएगा। इसके बजाय अपने बीमाकर्ता से पूछें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraはこれらを作成しましたが、お客様の文書と照合できなかったため、表示しません。代わりに保険会社にお問い合わせください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Covera elaborou-os, mas não conseguiu rastreá-los nos seus documentos, por isso não os mostrará. Pergunte à sua seguradora."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ร่างสิ่งเหล่านี้ขึ้นมาแต่ไม่สามารถอ้างอิงกับเอกสารของคุณได้ จึงจะไม่แสดง โปรดสอบถามผู้ให้บริการประกันของคุณแทน"
          }
        }
      }
    },
    "Covera is not a doctor and not a licensed insurance agent. This is a reading of your own documents, not medical advice and not a coverage decision. Your insurer decides what is covered.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ليس طبيبًا ولا وكيل تأمين مرخّصًا. هذه قراءة لمستنداتك الخاصة، وليست نصيحة طبية ولا قرار تغطية. شركة التأمين هي من تقرر ما هو مغطى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ist weder Arzt noch zugelassener Versicherungsvertreter. Dies ist eine Auslegung Ihrer eigenen Dokumente, keine medizinische Beratung und keine Leistungsentscheidung. Ihr Versicherer entscheidet, was abgedeckt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera no es médico ni agente de seguros autorizado. Esto es una lectura de sus propios documentos, no un consejo médico ni una decisión de cobertura. Su aseguradora decide qué está cubierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera n’est ni médecin ni agent d’assurance agréé. Il s’agit d’une lecture de vos propres documents, pas d’un avis médical ni d’une décision de couverture. Votre assureur décide de ce qui est couvert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera אינה רופא ואינה סוכן ביטוח מורשה. זוהי קריאה של המסמכים שלך בלבד, לא ייעוץ רפואי ולא החלטת כיסוי. חברת הביטוח שלך קובעת מה מכוסה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera न तो डॉक्टर है और न ही लाइसेंसधारी बीमा एजेंट। यह आपके अपने दस्तावेज़ों का पठन है, चिकित्सा सलाह या कवरेज निर्णय नहीं। क्या कवर है, यह आपका बीमाकर्ता तय करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraは医師でも認可を受けた保険代理店でもありません。これはご自身の書類の読み取りであり、医療上の助言や補償の判断ではありません。何が補償されるかは保険会社が決定します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera não é médico nem corretor de seguros licenciado. Esta é uma leitura dos seus próprios documentos, não um aconselhamento médico nem uma decisão de cobertura. Sua seguradora decide o que é coberto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ไม่ใช่แพทย์และไม่ใช่ตัวแทนประกันที่ได้รับอนุญาต นี่คือการอ่านเอกสารของคุณเอง ไม่ใช่คำแนะนำทางการแพทย์หรือการตัดสินความคุ้มครอง บริษัทประกันของคุณเป็นผู้ตัดสินว่าอะไรได้รับความคุ้มครอง"
          }
        }
      }
    },
    "Covera is not a doctor. It will not tell you whether to have a procedure, and it does not know your medical history.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ليس طبيبًا. لن يخبرك ما إذا كان يجب عليك إجراء عملية، ولا يعرف تاريخك الطبي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ist kein Arzt. Es wird Ihnen nicht sagen, ob Sie einen Eingriff vornehmen sollen, und es kennt Ihre Krankengeschichte nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera no es un médico. No le dirá si debe someterse a un procedimiento y no conoce su historial médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera n'est pas un médecin. L'application ne vous dira pas si vous devez subir une procédure, et elle ne connaît pas vos antécédents médicaux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera אינה רופא. היא לא תגיד לך אם לעבור הליך, והיא אינה יודעת את ההיסטוריה הרפואית שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera डॉक्टर नहीं है। यह आपको यह नहीं बताएगा कि कोई प्रक्रिया करानी है या नहीं, और इसे आपके मेडिकल इतिहास की जानकारी नहीं है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraは医師ではありません。処置を受けるべきかどうかを指示することはなく、お客様の病歴も知りません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Covera não é um médico. Não lhe dirá se deve fazer um procedimento e não conhece o seu histórico médico."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ไม่ใช่แพทย์ จะไม่บอกคุณว่าควรทำหัตถการหรือไม่ และไม่ทราบประวัติทางการแพทย์ของคุณ"
          }
        }
      }
    },
    "Covera is still reading this document. Nothing from it is used until every figure has been checked against its page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال Covera يقرأ هذا المستند. لا يتم استخدام أي شيء منه حتى يتم التحقق من كل رقم مقابل صفحته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera liest dieses Dokument noch. Nichts daraus wird verwendet, bevor jede Zahl mit der entsprechenden Seite abgeglichen wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera sigue leyendo este documento. No se usa nada hasta que cada cifra haya sido verificada con su página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera est toujours en train de lire ce document. Rien n'en est utilisé tant que chaque chiffre n'a pas été vérifié par rapport à sa page."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera עדיין קוראת מסמך זה. שום דבר ממנו אינו בשימוש עד שכל נתון נבדק מול העמוד שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera अभी भी यह दस्तावेज़ पढ़ रहा है। इसमें से कुछ भी तब तक उपयोग नहीं किया जाता जब तक कि हर अंक को उसके पृष्ठ से जाँच न लिया जाए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraはこの文書をまだ読み取り中です。すべての数値がページと照合されるまで、その内容は使用されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Covera ainda está a ler este documento. Nada dele é usado até que cada valor tenha sido verificado na sua página."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ยังคงอ่านเอกสารนี้อยู่ จะไม่มีการนำข้อมูลใดๆ จากเอกสารนี้ไปใช้จนกว่าตัวเลขทุกตัวจะได้รับการตรวจสอบกับหน้าเอกสารแล้ว"
          }
        }
      }
    },
    "Covera received a reply it could not read safely, so nothing is shown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقى Covera ردًا لم يتمكن من قراءته بأمان، لذلك لم يتم عرض أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera erhielt eine Antwort, die nicht sicher gelesen werden konnte, daher wird nichts angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera recibió una respuesta que no pudo leer de forma segura, por lo que no se muestra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera a reçu une réponse qu'il n'a pas pu lire en toute sécurité, donc rien n'est affiché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera קיבלה תשובה שלא יכלה לקרוא בבטחה, ולכן שום דבר לא מוצג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera को एक ऐसा जवाब मिला जिसे वह सुरक्षित रूप से पढ़ नहीं सका, इसलिए कुछ भी नहीं दिखाया गया है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraは安全に読み取れない返信を受け取ったため、何も表示されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Covera recebeu uma resposta que não pôde ler em segurança, por isso nada é mostrado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Covera ได้รับการตอบกลับที่ไม่สามารถอ่านได้อย่างปลอดภัย จึงไม่มีการแสดงสิ่งใด"
          }
        }
      }
    },
