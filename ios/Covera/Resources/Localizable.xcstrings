    "Removes your account, your uploaded documents and everything extracted from them. It cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل حسابك ومستنداتك المحملة وكل ما تم استخراجه منها. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Ihr Konto, Ihre hochgeladenen Dokumente und alles, was daraus extrahiert wurde. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina su cuenta, sus documentos subidos y todo lo extraído de ellos. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime votre compte, vos documents téléchargés et tout ce qui en a été extrait. Cela ne peut pas être annulé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר/ה את חשבונך, את המסמכים שהעלית ואת כל מה שחולץ מהם. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाता, आपके अपलोड किए गए दस्तावेज़ और उनसे निकाली गई सभी जानकारी हटा देता है। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、アップロードされた書類、およびそれらから抽出されたすべての情報を削除します。この操作は元に戻せません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove a sua conta, os seus documentos carregados e tudo o que foi extraído deles. Não pode ser desfeito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีของคุณ เอกสารที่อัปโหลด และข้อมูลทั้งหมดที่ดึงมาจากเอกสารเหล่านั้น การดำเนินการนี้ไม่สามารถย้อนกลับได้"
          }
        }
      }
    },
