    "Read and stored": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت القراءة والتخزين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelesen und gespeichert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído y guardado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu et stocké"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקרא ואוחסן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ा और सहेजा गया"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み・保存済み"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido e armazenado"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านและจัดเก็บแล้ว"
          }
        }
      }
    },
    "Read and stored. Every figure Covera quotes from this policy links back to its page, so you can always check the wording yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت القراءة والتخزين. كل رقم تستشهد به Covera من هذه الوثيقة يعود إلى صفحته الأصلية، حتى تتمكن دائمًا من التحقق من الصياغة بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelesen und gespeichert. Jede Zahl, die Covera aus dieser Police zitiert, verweist auf die entsprechende Seite, sodass Sie den Wortlaut jederzeit selbst überprüfen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído y guardado. Cada cifra que Covera cita de esta póliza enlaza a su página, para que siempre pueda verificar la redacción usted mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu et stocké. Chaque chiffre que Covera cite de cette police renvoie à sa page, afin que vous puissiez toujours vérifier le libellé vous-même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקרא ואוחסן. כל נתון ש-Covera מצטטת מפוליסה זו מקושר לעמוד המקורי, כך שתוכל/י תמיד לבדוק את הניסוח בעצמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ा और सहेजा गया। Covera इस पॉलिसी से जो भी जानकारी देती है, वह उसके मूल पेज से जुड़ी होती है, ताकि आप हमेशा खुद शब्दों की जाँच कर सकें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み、保存しました。Coveraがこの保険証券から引用するすべての数値は、そのページにリンクしており、いつでもご自身で文言を確認できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido e armazenado. Cada valor que a Covera cita desta apólice remete para a sua página, para que possa sempre verificar a redação por si."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านและจัดเก็บแล้ว ทุกตัวเลขที่ Covera อ้างอิงจากกรมธรรม์นี้จะเชื่อมโยงกลับไปยังหน้าต้นฉบับ คุณจึงสามารถตรวจสอบถ้อยคำได้ด้วยตนเอง"
          }
        }
      }
    },
