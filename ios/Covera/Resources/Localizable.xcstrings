          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלד DELETE"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DELETE टाइप करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DELETEと入力してください"
          }
        },
        "pt": {
