    "The full wording your insurer sent you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصياغة الكاملة التي أرسلها لك مؤمنك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vollständige Wortlaut, den Ihnen Ihr Versicherer geschickt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La redacción completa que su aseguradora le envió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le libellé complet que votre assureur vous a envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הניסוח המלא שחברת הביטוח שלך שלחה לך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बीमाकर्ता द्वारा आपको भेजे गए पूरे शब्द।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保険会社から送付された全文。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A redação completa que a sua seguradora lhe enviou."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้อยคำฉบับเต็มที่บริษัทประกันของคุณส่งมาให้"
          }
        }
      }
    },
    "The number they read out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرقم الذي قرأوه"
          }
        },
        "de": {
