          "stringUnit": {
            "state": "translated",
            "value": "Dans combien de temps ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתי זה קרוב?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कितनी जल्दी है?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつまでですか？"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando é?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เร็วแค่ไหน?"
          }
        }
      }
    },
    "I agree that Covera may process the health information in my documents to provide the service, as described in the Privacy Policy. I can withdraw this at any time by deleting my account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على أن Covera قد تعالج المعلومات الصحية في مستنداتي لتقديم الخدمة، كما هو موضح في سياسة الخصوصية. يمكنني سحب هذا في أي وقت عن طريق DELETE حسابي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme zu, dass Covera die Gesundheitsinformationen in meinen Dokumenten zur Bereitstellung des Dienstes verarbeiten darf, wie in der Datenschutzerklärung beschrieben. Ich kann dies jederzeit durch Löschen meines Kontos widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto que Covera puede procesar la información de salud en mis documentos para proporcionar el servicio, según se describe en la Política de Privacidad. Puedo retirar esto en cualquier momento eliminando mi cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accepte que Covera puisse traiter les informations de santé contenues dans mes documents pour fournir le service, tel que décrit dans la Politique de confidentialité. Je peux retirer ce consentement à tout moment en DELETE mon compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מסכים/ה ש-Covera תעבד את מידע הבריאות במסמכים שלי כדי לספק את השירות, כמתואר במדיניות הפרטיות. אני יכול/ה לבטל זאת בכל עת על ידי DELETE חשבוני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं सहमत हूँ कि Covera सेवा प्रदान करने के लिए मेरे दस्तावेज़ों में स्वास्थ्य जानकारी को संसाधित कर सकता है, जैसा कि गोपनीयता नीति में वर्णित है। मैं किसी भी समय अपना खाता DELETE करके इसे वापस ले सकता हूँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーポリシーに記載されている通り、Coveraがサービス提供のため私の書類内の健康情報を処理することに同意します。アカウントを削除することで、いつでもこの同意を撤回できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordo que a Covera pode processar as informações de saúde nos meus documentos para fornecer o serviço, conforme descrito na Política de Privacidade. Posso retirar este consentimento a qualquer momento, eliminando a minha conta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันตกลงให้ Covera ประมวลผลข้อมูลสุขภาพในเอกสารของฉันเพื่อให้บริการ ตามที่ระบุไว้ในนโยบายความเป็นส่วนตัว ฉันสามารถถอนความยินยอมนี้ได้ทุกเมื่อโดยการ DELETE บัญชีของฉัน"
          }
        }
      }
    },
    "I am 18 or older, and I agree that Covera may process the health information in my documents as described in the Privacy Policy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا أبلغ 18 عامًا أو أكثر، وأوافق على أن Covera قد تعالج المعلومات الصحية في مستنداتي كما هو موضح في سياسة الخصوصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin 18 Jahre oder älter und stimme zu, dass Covera die Gesundheitsinformationen in meinen Dokumenten wie in der Datenschutzerklärung beschrieben verarbeiten darf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengo 18 años o más, y acepto que Covera pueda procesar la información de salud en mis documentos según se describe en la Política de Privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai 18 ans ou plus, et j'accepte que Covera puisse traiter les informations de santé contenues dans mes documents, comme décrit dans la Politique de confidentialité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מעל גיל 18, ואני מסכים/ה ש-Covera רשאית לעבד את המידע הרפואי במסמכים שלי כמתואר במדיניות הפרטיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं 18 वर्ष या उससे अधिक का/की हूँ, और मैं सहमत हूँ कि Covera मेरे दस्तावेज़ों में मौजूद स्वास्थ्य संबंधी जानकारी को गोपनीयता नीति में बताए अनुसार प्रोसेस कर सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は18歳以上であり、Coveraがプライバシーポリシーに記載されている通りに私の書類内の健康情報を処理することに同意します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenho 18 anos ou mais e concordo que a Covera pode processar as informações de saúde nos meus documentos, conforme descrito na Política de Privacidade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันมีอายุ 18 ปีขึ้นไป และฉันตกลงว่า Covera อาจประมวลผลข้อมูลสุขภาพในเอกสารของฉันตามที่ระบุไว้ในนโยบายความเป็นส่วนตัว"
          }
        }
      }
    },
    "I am 18 or older, and I agree to the Terms of Use.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغ 18 عامًا أو أكثر، وأوافق على شروط الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin 18 Jahre oder älter und stimme den Nutzungsbedingungen zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengo 18 años o más, y acepto los Términos de Uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai 18 ans ou plus, et j'accepte les Conditions d'utilisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני בן/בת 18 ומעלה, ואני מסכים/ה לתנאי השימוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं 18 वर्ष या उससे अधिक का हूँ, और मैं उपयोग की शर्तों से सहमत हूँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は18歳以上であり、利用規約に同意します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenho 18 anos ou mais e concordo com os Termos de Utilização."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันมีอายุ 18 ปีขึ้นไป และฉันยอมรับข้อกำหนดการใช้งาน"
          }
        }
      }
    },
    "I understand that Covera is not medical, legal or insurance advice, that it can make mistakes, and that I will confirm anything important with my insurer before relying on it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتفهم أن Covera ليست نصيحة طبية أو قانونية أو تأمينية، وأنها قد ترتكب أخطاء، وأنني سأؤكد أي شيء مهم مع شركة التأمين الخاصة بي قبل الاعتماد عليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe, dass Covera keine medizinische, rechtliche oder Versicherungsberatung ist, dass Fehler auftreten können und dass ich wichtige Informationen vor der Nutzung mit meinem Versicherer bestätigen werde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que Covera no es asesoramiento médico, legal o de seguros, que puede cometer errores, y que confirmaré cualquier cosa importante con mi aseguradora antes de confiar en ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que Covera ne fournit pas de conseils médicaux, juridiques ou d'assurance, qu'il peut y avoir des erreurs, et que je confirmerai toute information importante auprès de mon assureur avant de m'y fier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מבין/ה ש-Covera אינה ייעוץ רפואי, משפטי או ביטוחי, שהיא עלולה לטעות, ושאאשר כל דבר חשוב מול המבטח שלי לפני שאסתמך עליה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं समझता हूँ कि Covera चिकित्सीय, कानूनी या बीमा संबंधी सलाह नहीं है, कि यह गलतियाँ कर सकता है, और मैं इस पर भरोसा करने से पहले अपने बीमाकर्ता से किसी भी महत्वपूर्ण बात की पुष्टि करूँगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coveraは医療、法律、保険に関するアドバイスではなく、誤りがある可能性があること、および重要な事項については、Coveraに依拠する前に保険会社に確認することを理解しています。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compreendo que a Covera não é um aconselhamento médico, legal ou de seguros, que pode cometer erros e que confirmarei qualquer informação importante com a minha seguradora antes de confiar nela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเข้าใจว่า Covera ไม่ใช่คำแนะนำทางการแพทย์ กฎหมาย หรือประกันภัย ว่าอาจเกิดข้อผิดพลาดได้ และฉันจะยืนยันข้อมูลสำคัญใดๆ กับบริษัทประกันของฉันก่อนที่จะเชื่อถือ"
          }
        }
      }
    },
    "If someone's life or health is at risk, call emergency services now. The insurance can wait until everyone is safe.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت حياة شخص أو صحته في خطر، اتصل بخدمات الطوارئ الآن. يمكن أن ينتظر التأمين حتى يصبح الجميع بأمان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Leben oder die Gesundheit einer Person in Gefahr ist, rufen Sie jetzt den Notdienst. Die Versicherung kann warten, bis alle in Sicherheit sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la vida o la salud de alguien está en riesgo, llame a emergencias ahora. El seguro puede esperar hasta que todos estén a salvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la vie ou la santé de quelqu'un est en danger, appelez les services d'urgence maintenant. L'assurance peut attendre que tout le monde soit en sécurité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם חייו או בריאותו של מישהו בסכנה, התקשר/י לשירותי חירום עכשיו. הביטוח יכול לחכות עד שכולם יהיו בטוחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि किसी के जीवन या स्वास्थ्य को खतरा है, तो तुरंत आपातकालीन सेवाओं को कॉल करें। बीमा तब तक इंतजार कर सकता है जब तक सब सुरक्षित न हों।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "命や健康に危険がある場合は、今すぐ緊急サービスに電話してください。保険のことは、全員の安全が確認されてからで構いません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a vida ou a saúde de alguém estiver em risco, ligue para os serviços de emergência agora. O seguro pode esperar até que todos estejam seguros."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากชีวิตหรือสุขภาพของใครบางคนตกอยู่ในความเสี่ยง โปรดโทรเรียกบริการฉุกเฉินทันที เรื่องประกันรอได้จนกว่าทุกคนจะปลอดภัย"
          }
        }
      }
    },
    "If you call them": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا اتصلت بهم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie sie anrufen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los llama"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous les appelez"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תתקשר אליהם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्हें फ़ोन करने पर।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話でお問い合わせの場合"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lhes ligar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณโทรหาพวกเขา"
          }
        }
      }
    },
    "Is dental treatment covered?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل علاج الأسنان مشمول؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist Zahnbehandlung abgedeckt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Está cubierto el tratamiento dental?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soins dentaires sont-ils couverts ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם טיפול שיניים מכוסה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या दाँतों का इलाज कवर है?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歯科治療は補償されますか？"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tratamento dentário está coberto?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรักษาทางทันตกรรมครอบคลุมหรือไม่?"
          }
        }
      }
    },
    "Is there already a referral?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل توجد إحالة مسبقًا؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt es bereits eine Überweisung?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya hay una remisión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y a-t-il déjà une référence ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם יש כבר הפניה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या पहले से कोई रेफरल है?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紹介状はすでにありますか？"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um encaminhamento?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการส่งต่อแล้วหรือยัง?"
          }
        }
      }
    },
    "It is being read page by page, not skimmed, and every figure is checked against its page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقرأ صفحة بصفحة، لا تصفحًا، ويُدقّق كل رقم مقابل صفحته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird Seite für Seite gelesen, nicht überflogen, und jede Zahl wird mit der entsprechenden Seite abgeglichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está leyendo página por página, no por encima, y cada cifra se verifica con su página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est lu page par page, non survolé, et chaque chiffre est vérifié par rapport à sa page."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקרא עמוד אחר עמוד, לא ברפרוף. כל נתון נבדק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पृष्ठ-दर-पृष्ठ पढ़ा जा रहा है, सरसरी तौर पर नहीं। हर आंकड़ा उसके पृष्ठ से जाँचा जा रहा है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページごとに読み込み、流し読みはしていません。すべての数値はページと照合済みです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a ser lido página a página, não superficialmente, e cada valor é verificado na sua página."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังอ่านทีละหน้า ไม่ได้อ่านผ่านๆ และตรวจสอบตัวเลขทุกตัวกับหน้าเอกสาร"
          }
        }
      }
    },
    "It is happening now, or just happened": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
