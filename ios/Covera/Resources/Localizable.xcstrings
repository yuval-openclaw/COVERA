    "Please read and agree to each of these before adding a policy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى قراءة كل من هذه والموافقة عليها قبل إضافة بوليصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lesen und stimmen Sie jedem Punkt zu, bevor Sie eine Police hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, lea y acepte cada uno de estos puntos antes de añadir una póliza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez lire et accepter chacun de ces points avant d'ajouter une police."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא קרא/י והסכים/ה לכל אחד מאלה לפני הוספת פוליסה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉलिसी जोड़ने से पहले कृपया इनमें से प्रत्येक को पढ़ें और सहमत हों।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保険証券を追加する前に、これらすべてを読み、同意してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, leia e concorde com cada um destes pontos antes de adicionar uma apólice."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดอ่านและยอมรับแต่ละข้อเหล่านี้ก่อนเพิ่มกรมธรรม์"
          }
        }
      }
    },
