    "Read this out. It asks only what your documents leave open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ هذا. إنه يسأل فقط عما تتركه مستنداتك مفتوحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen Sie dies vor. Es fragt nur, was Ihre Dokumente offenlassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lea esto. Solo pregunta lo que sus documentos dejan abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez ceci. Cela ne demande que ce que vos documents laissent en suspens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קרא/י זאת. זה שואל רק מה שהמסמכים שלך משאירים פתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पढ़ें। यह केवल वही पूछता है जो आपके दस्तावेज़ों में स्पष्ट नहीं है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを読み上げてください。書類に記載されていないことのみを尋ねます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia isto. Pergunta apenas o que os seus documentos deixam em aberto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อความนี้ ระบบจะถามเฉพาะข้อมูลที่เอกสารของคุณยังไม่ระบุ"
          }
        }
      }
    },
