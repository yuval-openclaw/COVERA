    "A consultant, a scan, blood work": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استشاري، مسح ضوئي، فحص دم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Berater, ein Scan, Blutuntersuchung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un especialista, un escaneo, análisis de sangre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un consultant, un scan, une analyse de sang"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יועץ, סריקה, בדיקות דם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सलाहकार, एक स्कैन, रक्त परीक्षण"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンサルタント、スキャン、血液検査"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um consultor, um exame de imagem, exames de sangue"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรึกษาแพทย์, สแกน, ตรวจเลือด"
          }
        }
      }
    },
    "A few quick answers make the plan more precise.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الإجابات السريعة تجعل الخطة أكثر دقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar schnelle Antworten machen den Plan präziser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas respuestas rápidas hacen el plan más preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques réponses rapides rendent le plan plus précis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה תשובות מהירות יהפכו את התוכנית למדויקת יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ त्वरित उत्तर योजना को अधिक सटीक बनाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかの簡単な回答で、プランがより正確になります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas respostas rápidas tornam o plano mais preciso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบสั้นๆ เพียงไม่กี่ข้อจะช่วยให้แผนมีความแม่นยำยิ่งขึ้น"
          }
        }
      }
    },
    "A few taps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بضع نقرات"
          }
        },
        "de": {
