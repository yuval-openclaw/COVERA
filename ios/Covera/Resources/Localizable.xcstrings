    "Optional — but a little detail makes the plan sharper.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري — لكن التفاصيل الصغيرة تجعل الخطة أوضح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional – aber ein kleines Detail macht den Plan präziser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional — pero un pequeño detalle afina el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif — mais un petit détail rend le plan plus précis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופציונלי – אך פרט קטן מחדד את התוכנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक — लेकिन थोड़ा विवरण योजना को अधिक स्पष्ट बनाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意 — 詳細を追加するとプランがより明確になります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional — mas um pequeno detalhe torna o plano mais claro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ — แต่รายละเอียดเล็กน้อยจะทำให้แผนชัดเจนขึ้น"
          }
        }
      }
    },
