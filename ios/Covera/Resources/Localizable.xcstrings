    "One JSON file with your account, your policies and everything read from them, citations included.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف JSON واحد بحسابك، وثائقك، وكل ما قُرئ منها، مع المراجع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine JSON-Datei mit Ihrem Konto, Ihren Policen und allen daraus gelesenen Informationen, inklusive Quellenangaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo JSON con su cuenta, sus pólizas y todo lo leído de ellas, citas incluidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier JSON avec votre compte, vos polices et tout ce qui en a été extrait, citations incluses."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ JSON אחד עם חשבונך, פוליסותיך וכל המידע שנקרא מהן, כולל ציטוטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खाते, पॉलिसियों और उनसे पढ़ी गई सभी जानकारी (उद्धरण सहित) वाली एक JSON फ़ाइल।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、保険契約、読み取られたすべての情報（引用元を含む）をまとめた1つのJSONファイル。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ficheiro JSON com a sua conta, as suas apólices e tudo o que foi lido delas, incluindo citações."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ JSON หนึ่งไฟล์ที่มีบัญชีของคุณ กรมธรรม์ของคุณ และทุกสิ่งที่อ่านได้จากกรมธรรม์นั้น รวมถึงการอ้างอิง"
