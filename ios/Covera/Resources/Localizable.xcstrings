          }
        }
      }
    },
    "Add the full policy wording your insurer sent you, not the summary page. Covera reads it page by page and keeps the page number for every figure.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف النص الكامل لوثيقة التأمين التي أرسلها لك مؤمنك، وليس صفحة الملخص. Covera تقرأها صفحة بصفحة وتحتفظ برقم الصفحة لكل معلومة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den vollständigen Wortlaut der Police hinzu, den Ihnen Ihr Versicherer geschickt hat, nicht die Zusammenfassungsseite. Covera liest sie Seite für Seite und speichert die Seitenzahl für jede Angabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada el texto completo de la póliza que le envió su aseguradora, no la página de resumen. Covera lo lee página por página y guarda el número de página para cada cifra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le texte intégral de la police que votre assureur vous a envoyé, pas la page de résumé. Covera le lit page par page et conserve le numéro de page pour chaque chiffre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף את נוסח הפוליסה המלא ששלח לך המבטח, לא את דף הסיכום. Covera קוראת אותו עמוד אחר עמוד ושומרת את מספר העמוד עבור כל נתון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉलिसी का पूरा विवरण जोड़ें जो आपके बीमाकर्ता ने आपको भेजा है, सारांश पृष्ठ नहीं। Covera इसे पृष्ठ दर पृष्ठ पढ़ता है और हर आंकड़े के लिए पृष्ठ संख्या रखता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保険会社から送付されたポリシーの全文を追加してください。要約ページではありません。Coveraはそれをページごとに読み取り、すべての数値のページ番号を保持します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o texto completo da apólice que a sua seguradora lhe enviou, não a página de resumo. A Covera lê página por página e guarda o número da página para cada dado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มข้อความกรมธรรม์ฉบับเต็มที่บริษัทประกันส่งให้คุณ ไม่ใช่หน้าสรุป Covera จะอ่านทีละหน้าและเก็บเลขหน้าสำหรับทุกตัวเลข"
          }
        }
      }
    },
    "Add your first policy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف وثيقتك الأولى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Ihre erste Police hinzu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añada su primera póliza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre première police"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף את הפוליסה הראשונה שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पहली पॉलिसी जोड़ें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のポリシーを追加"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar a sua primeira apólice"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มกรมธรรม์ฉบับแรกของคุณ"
          }
        }
      }
    },
    "After each call, write down the date, who you spoke to and the reference number they gave you. If the insurer later says something different, this is what settles it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد كل مكالمة، دوّن التاريخ، ومن تحدثت إليه، والرقم المرجعي الذي أعطوك إياه. إذا قال المؤمن شيئًا مختلفًا لاحقًا، فهذا ما يحسم الأمر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Anruf Datum, Gesprächspartner und die erhaltene Referenznummer notieren. Falls die Versicherung später etwas anderes sagt, ist dies entscheidend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cada llamada, anote la fecha, con quién habló y el número de referencia que le dieron. Si la aseguradora dice algo diferente más tarde, esto es lo que lo resuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque appel, notez la date, votre interlocuteur et le numéro de référence qu'ils vous ont donné. Si l'assureur dit ensuite autre chose, c'est ce qui fait foi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי כל שיחה, רשום את התאריך, עם מי דיברת ואת מספר האסמכתא שקיבלת. אם חברת הביטוח תגיד משהו אחר מאוחר יותר, זה מה שיכריע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर कॉल के बाद, तारीख, जिससे बात की और संदर्भ संख्या लिख लें। यदि बीमाकर्ता बाद में कुछ और कहे, तो यही निर्णायक होगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話ごとに、日付、相手、参照番号を記録してください。保険会社が後で異なることを言っても、この記録が解決の決め手となります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após cada chamada, anote a data, com quem falou e o número de referência que lhe deram. Esta informação é crucial caso a seguradora apresente uma versão diferente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังการโทรแต่ละครั้ง โปรดจดวันที่ ผู้ที่คุณคุยด้วย และหมายเลขอ้างอิงที่ได้รับ หากบริษัทประกันแจ้งข้อมูลที่แตกต่างไปในภายหลัง ข้อมูลนี้จะช่วยยืนยันได้"
          }
        }
      }
    },
    "Agree and continue": {
