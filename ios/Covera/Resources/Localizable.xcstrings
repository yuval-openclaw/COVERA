            "value": "Unos toques"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques touches"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה הקשות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ टैप"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数回のタップ"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns toques"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะไม่กี่ครั้ง"
          }
        }
      }
    },
    "A guest account has no password, so signing out deletes it, with every policy in it. To keep your policies, export them first or create an account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب الضيف ليس له كلمة مرور، لذا فإن تسجيل الخروج يحذفه مع كل وثيقة تأمين فيه. للاحتفاظ بوثائقك، قم بتصديرها أولاً أو أنشئ حسابًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gastkonto hat kein Passwort, daher wird es beim Abmelden gelöscht, mit allen darin enthaltenen Policen. Um Ihre Policen zu behalten, exportieren Sie diese zuerst oder erstellen Sie ein Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta de invitado no tiene contraseña, por lo que cerrar sesión la elimina, con todas las pólizas que contiene. Para conservar sus pólizas, expórtelas primero o cree una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte invité n'a pas de mot de passe. La déconnexion le supprime, ainsi que toutes ses polices. Pour les conserver, exportez-les d'abord ou créez un compte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחשבון אורח אין סיסמה, לכן יציאה מוחקת אותו ואת כל הפוליסות שבו. כדי לשמור את הפוליסות שלך, ייצא אותן קודם או צור חשבון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अतिथि खाते का कोई पासवर्ड नहीं होता, इसलिए साइन आउट करने से यह इसमें मौजूद हर पॉलिसी के साथ हट जाएगा। अपनी पॉलिसियों को रखने के लिए, पहले उन्हें निर्यात करें या एक खाता बनाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストアカウントにはパスワードがありません。サインアウトすると、含まれるすべての保険証券とともに削除されます。保険証券を保持するには、まずエクスポートするか、アカウントを作成してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta de convidado não tem senha, então sair a exclui, com todas as apólices nela. Para manter suas apólices, exporte-as primeiro ou crie uma conta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีผู้เยี่ยมชมไม่มีรหัสผ่าน การออกจากระบบจะลบบัญชีและกรมธรรม์ทั้งหมดในนั้น หากต้องการเก็บกรมธรรม์ของคุณไว้ โปรดส่งออกก่อนหรือสร้างบัญชี"
          }
        }
      }
    },
    "A guest can't sign back in after signing out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للضيف تسجيل الدخول مرة أخرى بعد تسجيل الخروج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gast kann sich nach dem Abmelden nicht wieder anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un invitado no puede volver a iniciar sesión después de cerrar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un invité ne peut pas se reconnecter après s'être déconnecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורח אינו יכול להיכנס שוב לאחר יציאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अतिथि साइन आउट करने के बाद फिर से साइन इन नहीं कर सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストはサインアウトすると、再度サインインできません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um convidado não pode iniciar sessão novamente depois de terminar a sessão."
          }
        },
