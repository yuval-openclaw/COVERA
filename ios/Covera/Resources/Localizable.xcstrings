          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขที่แจ้ง"
          }
        }
      }
    },
    "The scan had no pages Covera could use. Try again in better light.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحتوي المسح الضوئي على صفحات يمكن لـ Covera استخدامها. حاول مرة أخرى في إضاءة أفضل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan enthielt keine Seiten, die Covera verwenden konnte. Versuchen Sie es erneut bei besserem Licht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo no tenía páginas que Covera pudiera usar. Intente de nuevo con mejor luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scan ne contenait aucune page que Covera pouvait utiliser. Réessayez avec une meilleure lumière."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסריקה לא הכילה דפים ש-Covera יכלה להשתמש בהם. נסה שוב בתאורה טובה יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन में ऐसे कोई पेज नहीं थे जिनका Covera उपयोग कर सके। बेहतर रोशनी में फिर से कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンにはCoveraが使用できるページがありませんでした。より良い照明でもう一度お試しください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A digitalização não tinha páginas que Covera pudesse usar. Tente novamente com melhor iluminação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสแกนไม่มีหน้ากระดาษที่ Covera ใช้ได้ โปรดลองอีกครั้งในที่ที่มีแสงสว่างดีกว่า"
          }
        }
      }
    },
    "There is no PDF on the clipboard. Copy the policy file first, then paste it here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملف PDF في الحافظة. انسخ ملف وثيقة التأمين أولاً، ثم الصقه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es befindet sich kein PDF in der Zwischenablage. Kopieren Sie zuerst die Versicherungsdatei und fügen Sie sie dann hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún PDF en el portapapeles. Copie primero el archivo de la póliza, luego péguelo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de PDF dans le presse-papiers. Copiez d'abord le fichier de la police, puis collez-le ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין קובץ PDF בלוח הגזירים. העתק תחילה את קובץ הפוליסה, ואז הדבק אותו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड पर कोई PDF नहीं है। पहले पॉलिसी फ़ाइल कॉपी करें, फिर इसे यहाँ चिपकाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードにPDFがありません。まず、保険証券ファイルをコピーしてから、ここに貼り付けてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há PDF na área de transferência. Copie o arquivo da apólice primeiro, depois cole-o aqui."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีไฟล์ PDF อยู่ในคลิปบอร์ด กรุณาคัดลอกไฟล์กรมธรรม์ก่อน แล้วจึงนำมาวางที่นี่"
          }
        }
      }
    },
    "This device has no passcode or biometric lock, so Covera cannot lock your documents.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الجهاز على رمز مرور أو قفل بيومتري، لذلك لا يمكن لـ Covera قفل مستنداتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keinen Passcode oder biometrische Sperre, daher kann Covera Ihre Dokumente nicht sperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene código o bloqueo biométrico, por lo que Covera no puede bloquear sus documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'a pas de code d'accès ou de verrouillage biométrique, donc Covera ne peut pas verrouiller vos documents."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למכשיר זה אין קוד גישה או נעילה ביומטרית, ולכן Covera לא יכולה לנעול את המסמכים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस में कोई पासकोड या बायोमेट्रिक लॉक नहीं है, इसलिए Covera आपके दस्तावेज़ों को लॉक नहीं कर सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはパスコードまたは生体認証ロックが設定されていないため、Coveraは書類をロックできません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem código de acesso ou bloqueio biométrico, então Covera não pode bloquear seus documentos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ไม่มีรหัสผ่านหรือการล็อกด้วยไบโอเมตริกซ์ Covera จึงไม่สามารถล็อกเอกสารของคุณได้"
          }
        }
      }
    },
    "This document could not be read with enough confidence to quote it accurately, so nothing from it is used. A clearer scan, or the original PDF from your insurer, usually works.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر قراءة هذا المستند بثقة كافية لاقتباسه بدقة، لذلك لم يتم استخدام أي شيء منه. عادةً ما ينجح المسح الضوئي الأكثر وضوحًا، أو ملف PDF الأصلي من شركة التأمين الخاصة بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument konnte nicht mit ausreichender Sicherheit gelesen werden, um es genau zu zitieren, daher wird nichts davon verwendet. Ein klarerer Scan oder das Original-PDF Ihres Versicherers funktioniert normalerweise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento no pudo leerse con suficiente confianza para citarlo con precisión, por lo que no se utiliza nada de él. Un escaneo más claro, o el PDF original de su aseguradora, suele funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document n'a pas pu être lu avec une confiance suffisante pour être cité avec précision, donc rien n'en est utilisé. Un scan plus clair, ou le PDF original de votre assureur, fonctionne généralement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא מסמך זה בביטחון מספק כדי לצטט אותו במדויק, ולכן שום דבר ממנו לא בשימוש. סריקה ברורה יותר, או קובץ ה-PDF המקורי מהמבטח שלך, בדרך כלל עובדים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दस्तावेज़ को इतनी सटीकता से नहीं पढ़ा जा सका कि इसे सही ढंग से उद्धृत किया जा सके, इसलिए इसमें से कुछ भी उपयोग नहीं किया गया है। एक स्पष्ट स्कैन, या आपके बीमाकर्ता से मूल PDF, आमतौर पर काम करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類は正確に引用できるほど十分に読み取れなかったため、内容は使用されません。より鮮明なスキャン、または保険会社からの元のPDFが通常は機能します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento não pôde ser lido com confiança suficiente para citação precisa, então nada dele é usado. Uma digitalização mais nítida, ou o PDF original da sua seguradora, geralmente funciona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารนี้ไม่สามารถอ่านได้อย่างแม่นยำพอที่จะอ้างอิงได้ จึงไม่มีการนำข้อมูลใดๆ จากเอกสารนี้ไปใช้ การสแกนที่ชัดเจนขึ้น หรือไฟล์ PDF ต้นฉบับจากบริษัทประกันของคุณมักจะใช้ได้ผล"
          }
        }
      }
    },
    "This note is only on this device, so it cannot be recovered.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الملاحظة موجودة على هذا الجهاز فقط، لذا لا يمكن استعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz ist nur auf diesem Gerät und kann daher nicht wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota está solo en este dispositivo, por lo que no se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note est uniquement sur cet appareil, elle ne peut donc pas être récupérée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערה זו נמצאת רק במכשיר זה, ולכן לא ניתן לשחזר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नोट केवल इसी डिवाइस पर है, इसलिए इसे वापस नहीं पाया जा सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモは本デバイスのみに保存されており、復元できません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota está apenas neste dispositivo, portanto, não pode ser recuperada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกนี้มีอยู่เฉพาะในอุปกรณ์นี้เท่านั้น จึงไม่สามารถกู้คืนได้"
          }
        }
      }
    },
